###
### 5. pathway enrichment map (MF: molecular function)
###
# Load libraries
rm(list=ls())
library(clusterProfiler); library(enrichplot); library(org.Hs.eg.db);library(tidyverse)  

partner_gene <- read_excel("/gpfs/gsfs12/users/kimy35/BC-SELECT1.5/BC_SELECT_Supplementary Tables.xlsx", sheet = "Supplementary Table2", col_names = FALSE)
partner_gene <- partner_gene[-c(1,3),-c(1)] 
colnames(partner_gene) <- as.character(unlist(partner_gene[1, ]))  # Set first row as column names
partner_gene <- partner_gene[-1, -1]  

gene_symbols <- partner_gene$`SR, BC-SELECT (Immunotherapy)`[1:10]  # convert gene symbols to Entrez IDs
gene_symbols <- partner_gene$`SL, TRASTUZUMAB`[1:55]
gene_symbols <- partner_gene$`SDL, TRASTUZUMAB` # no results
gene_symbols <- partner_gene$`SL, VELIPARIB`[1:55] # no results
gene_symbols <- partner_gene$`SDL, VELIPARIB`[1:55] # no results
gene_symbols <- partner_gene$`SL, OLAPARIB`[1:55] # no results
gene_symbols <- partner_gene$`SDL, OLAPARIB`[1:55] # no results

gene_df <- bitr(gene_symbols,
                fromType = "SYMBOL",
                toType = "ENTREZID",
                OrgDb = org.Hs.eg.db)

ego <- enrichGO(gene         = gene_df$ENTREZID, # GO biological process enrichment
                OrgDb        = org.Hs.eg.db,
                keyType      = "ENTREZID",
                ont          = "MF",  # Molecular Function
                pAdjustMethod = "BH",
                pvalueCutoff = 0.05, 
                qvalueCutoff = 0.05, 
                readable     = TRUE)

ego <- pairwise_termsim(ego) # add similarity scores to enrichment results

pdf("GO_barplot_SR.pdf", width = 10, height = 10) 
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Terms: SR immunotherapy")

pdf("GO_barplot_SL_TRASTUZUBAB.pdf", width = 10, height = 10) 
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Terms: SL partner for TRASTUZUMAB")

pdf("GO_barplot_SDL_TRASTUZUBAB.pdf", width = 10, height = 10) 
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Terms: SDL partner for TRASTUZUMAB")

pdf("GO_barplot_SL_VELIPARIB.pdf", width = 10, height = 10) 
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Terms: SL partner for VELIPARIB")

pdf("GO_barplot_SDL_VELIPARIB.pdf", width = 10, height = 10) 
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Terms: SDL partner for VELIPARIB")

pdf("GO_barplot_SL_OLAPARIB.pdf", width = 10, height = 10) 
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Terms: SL partner for OLAPARIB")

pdf("GO_barplot_SDL_OLAPARIB.pdf", width = 10, height = 10) 
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Terms: SDL partner for OLAPARIB")

dev.off()
