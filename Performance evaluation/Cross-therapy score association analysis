# SL
calc_sl_score <- function(drug_pair_col, drug_targets, score_name, expr_mat) {
  # Keep only genes present in both gene lists and expression matrix
  sub_gene <- intersect(tcga_list, rownames(expr_mat))
  data1 <- expr_mat[rownames(expr_mat) %in% sub_gene, , drop = FALSE]
  data2 <- expr_mat[rownames(expr_mat) %in% bc_gene_list, , drop = FALSE]
  
  # Normalize
  prediction_data_row_norm <- bin_matrix(data1, direction = "row", bin = FALSE)
  prediction_data_col_norm <- bin_matrix(data1, direction = "column", bin = FALSE)
  
  # SL pairs
  pair <- BC_SELECT_Supplementary_Tables[[drug_pair_col]][1:55]
  pair <- intersect(pair, rownames(prediction_data_row_norm))
  
  # SL pair scores
  pair_mat <- prediction_data_row_norm[pair, , drop = FALSE]
  
  potential_sl <- 0;  active_sl <- 0
  
  if (sum(!is.na(pair_mat)) / length(pair_mat) > 0.5) {
    potential_sl <- ifelse(!is.na(pair_mat), potential_sl + 1, potential_sl)
    active_sl <- ifelse(pair_mat < 0.33 & !is.na(pair_mat), active_sl + 1, active_sl) }
  
  # Whole SL score
  prediction_data_row_norm2 <- bin_matrix(data2, direction = "row", bin = FALSE)
  prediction_data_row_norm2 <- na.omit(prediction_data_row_norm2)
  whole_down <- apply(prediction_data_row_norm2, 2, down_counts)
  whole_down_patient <- as.numeric(colSums(whole_down))
  whole_sl_score <- whole_down_patient / nrow(prediction_data_row_norm2)
  
  # Target score
  tscore <- colSums((prediction_data_col_norm[drug_targets, , drop = FALSE] >= 0.2) * 1, na.rm = TRUE) / length(drug_targets)
  normal_expression_targets <- as.numeric(colMeans(prediction_data_row_norm[drug_targets, , drop = FALSE], na.rm = TRUE) )
  
  # Final score
  old_sl_score <- (colSums(active_sl, na.rm = TRUE) / colSums(potential_sl, na.rm = TRUE)) * tscore
  new_sl_score <- old_sl_score / whole_sl_score
  new_sl_score_target <- new_sl_score * normal_expression_targets
  
  out <- data.frame(new_sl_score_target)
  colnames(out) <- score_name; rownames(out) <- colnames(prediction_data_row_norm)
  
  out }



# SDL
calc_sdl_score <- function(drug_pair_col, drug_targets, score_name, expr_mat) {
  # Keep only genes present in both gene lists and expression matrix
  sub_gene <- intersect(tcga_list, rownames(expr_mat))
  data1 <- expr_mat[rownames(expr_mat) %in% sub_gene, , drop = FALSE]
  data2 <- expr_mat[rownames(expr_mat) %in% bc_gene_list, , drop = FALSE]
  
  # Normalize
  prediction_data_row_norm <- bin_matrix(data1, direction = "row", bin = FALSE)
  prediction_data_col_norm <- bin_matrix(data1, direction = "column", bin = FALSE)
  
  # SDL pairs
  pair <- BC_SELECT_Supplementary_Tables[[drug_pair_col]][1:55]
  pair <- intersect(pair, rownames(prediction_data_row_norm))
  
  pair_mat <- prediction_data_row_norm[pair, , drop = FALSE]
  
  potential_sdl <- 0; active_sdl <- 0
  
  if (sum(!is.na(pair_mat)) / length(pair_mat) > 0.5) {
    potential_sdl <- ifelse(!is.na(pair_mat), potential_sdl + 1, potential_sdl)
    active_sdl <- ifelse(pair_mat > (1 - 0.33) & !is.na(pair_mat), active_sdl + 1, active_sdl ) }
  
  # Whole SDL score
  prediction_data_row_norm2 <- bin_matrix(data2, direction = "row", bin = FALSE)
  prediction_data_row_norm2 <- na.omit(prediction_data_row_norm2)
  whole_up <- apply(prediction_data_row_norm2, 2, up_counts)
  whole_up_patient <- as.numeric(colSums(whole_up))
  whole_sdl_score <- whole_up_patient / nrow(prediction_data_row_norm2)
  
  # Target score
  tscore <- colSums( (prediction_data_col_norm[drug_targets, , drop = FALSE] >= 0.2) * 1, na.rm = TRUE ) / length(drug_targets)
  
  expression_targets <- prediction_data_row_norm[drug_targets, , drop = FALSE]
  normal_expression_targets <- as.numeric( colMeans(expression_targets, na.rm = TRUE) )
  
  # Final SDL score
  old_sdl_score <- (colSums(active_sdl, na.rm = TRUE) /colSums(potential_sdl, na.rm = TRUE)) * tscore
  new_sdl_score <- old_sdl_score / whole_sdl_score
  new_sdl_score_target <- new_sdl_score * normal_expression_targets
  
  out <- data.frame(new_sdl_score_target)
  colnames(out) <- score_name; rownames(out) <- colnames(prediction_data_row_norm)
  out }


# SR
calc_sr_score <- function(drug_pair_col, drug_targets, score_name, expr_mat) {
  # Keep only genes present in nanostring list and expression matrix
  sub_gene <- intersect(nanostring, rownames(expr_mat))
  data1 <- expr_mat[rownames(expr_mat) %in% sub_gene, , drop = FALSE]
  
  # Normalize
  prediction_data_row_norm <- bin_matrix(data1, direction = "row", bin = FALSE)
  
  # SR partner genes
  partners1 <- BC_SELECT_Supplementary_Tables[[drug_pair_col]][1:10]
  partners1 <- intersect(partners1, rownames(prediction_data_row_norm))
  
  # SR score1
  score1 <- colSums(prediction_data_row_norm[partners1, , drop = FALSE] < 0.33, na.rm = TRUE) / length(partners1)
  
  # Whole-gene down score
  new_data2 <- bin_matrix(data1, direction = "row", bin = FALSE)
  new_data2 <- na.omit(new_data2)
  whole_down <- apply(new_data2, 2, down_counts)
  whole_down_patient <- as.numeric(colSums(whole_down))
  whole_score <- whole_down_patient / nrow(new_data2)
  new_score <- (1 - score1) / (1 - whole_score)
  
  # Target expression score
  target_expr <- prediction_data_row_norm[drug_targets, , drop = FALSE]
  target <- apply(target_expr, 2, prod, na.rm = TRUE)
  
  # Final SR score (score2 only)
  score2 <- new_score * rank_normalization(target)
  out <- data.frame(score2)
  colnames(out) <- score_name
  rownames(out) <- colnames(prediction_data_row_norm)
  
  out }



