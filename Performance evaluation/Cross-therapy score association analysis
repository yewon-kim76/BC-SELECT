make_scatter_panel <- function(df, xvar, yvar, subtitle,
                               xlab = "SR score",
                               ylab = "SL score",
                               point_size = 2.5) {
  r_val <- cor(df[[xvar]], df[[yvar]], method = "spearman", use = "complete.obs")
  
  ggplot(df, aes(x = .data[[xvar]], y = .data[[yvar]])) +
    geom_point(size = point_size, shape = 21, fill = "white", color = "black", stroke = 1) +
    geom_smooth(method = "lm", se = FALSE, color = "red", linewidth = 1) +
