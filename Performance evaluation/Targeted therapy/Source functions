# Stouffer's Method (Z-transform or normal-based method)
if(method == "stouffer"){
combine_pvalues_stouffer <- function(pvals) {
  Z_scores <- apply(pvals, 2, p_to_z) # Convert p-values to Z-scores
  weights <- sqrt(c(1075, 1075, 1989, 1989, 2969, 2969)) # The weight is the square root of the sample sizes.
  combined_Z <- rowSums(t(t(Z_scores) * weights), na.rm = TRUE) / sqrt(sum(weights^2)) # Combine Z-scores using weighted sum
  combined_pvals <- 1 - pnorm(combined_Z) # Convert combined Z-scores back to p-values
  return(combined_pvals) }

# Apply the function to combine p-values across all datasets
combined_pvals <- combine_pvalues_stouffer(cox_result[, -c(1,2)])
adjusted_pvals <- p.adjust(combined_pvals, method = "BH") # Perform FDR correction

# Create a data frame with gene names, combined p-values, and adjusted p-values
cox_results <- data.frame(
  cox_result,
  combined_pval = combined_pvals,
  adjusted_pval = adjusted_pvals)

 cox_results <- cox_results[which(cox_results$adjusted_pval < FDR),]  
 candidates <- merge(candidates, cox_results, by = c("GENE_A", "GENE_B"), all = FALSE) }

#Fisher's Method (Chi-square-based)
if(method == "fisher"){
  weights <- sqrt(c(1075, 1075, 1989, 1989, 2969, 2969)) # The weight is the function of the square root of the sample sizes.
  weights <- 2*weights/sqrt(sum(weights^2)) # 2*stouffer's method
  log_p_values <- log(cox_result[, -c(1,2)]); log_p_values[is.na(log_p_values)] <- 0 # 6 one-tailed p-values 
  fisher_stat <- (-2)*(as.matrix(log_p_values)%*%weights)
  combined_p_vals <- pchisq(fisher_stat, df = 2 * sum(weights), lower.tail = FALSE)
  adjusted_pvals <- p.adjust(combined_p_vals, method = "BH") # Perform FDR correction
  
  cox_results <- data.frame(
    cox_result,
    combined_pval = combined_p_vals,
    adjusted_pval = adjusted_pvals)

  cox_results <- cox_results[which(cox_results$adjusted_pval < FDR),]  
  candidates <- merge(candidates, cox_results, by = c("GENE_A", "GENE_B"), all = FALSE) } }

