  potential_sl <- ifelse(!is.na(prediction_data_row_norm[pair, ]), potential_sl + 1, potential_sl)
  active_sl <- ifelse(prediction_data_row_norm[pair, ] < 0.33 & !is.na(prediction_data_row_norm[pair, ]), 
                      active_sl + 1, active_sl) }
  
