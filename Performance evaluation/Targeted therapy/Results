## We applied BC-SELECT to seven independent breast cancer trials focusing on targeted therapies. 
## These trials include four involving trastuzumab and three evaluating PARP inhibitors (veliparib or olaparib). 
## Drug response prediction accuracy was assessed using odds ratios, ROC-AUCs, precision-recall curves, and empirical p-values.
## For the targeted therapy module, we conducted SL and SDL analyses and reported the results with better performance

rm(list=ls())
set.seed(12345) # Simulation for empirical p-values
setwd("/data/kimy35/BC-SELECT1.5")
source("./Ranking_Pairs5.R") # Source functions

nn=55 # the number of SL/SDL partner genes used in the analysis
tcga_list <- readRDS(file = "./TCGA_genes.rds"); tcga_list <- tcga_list[1:19001] # Genes included in TCGA
bc_gene_list <- read.delim("./bc_gene_list.txt", stringsAsFactors=TRUE); bc_gene_list <- as.character(bc_gene_list$Gene.Symbol)
# Both the identified partner genes and the genes included in NanoString were used to evaluate a patient's drug efficacy.

##
## Drug: TRASTUZUMAB, Target gene: ERBB2
##
candidates_sl <- mono_target2(drugs = "TRASTUZUMAB", interaction = "SL", FDR = 0.2, method = "min")
candidates_sdl <- mono_target2(drugs = "TRASTUZUMAB", interaction = "SDL", FDR = 0.2, method = "min")

# Evaluation data: GSE50948
load("./dat.GSE50948.RData"); GSE50948 <- dat
sub_gene <- intersect(tcga_list, GSE50948$genes) 
GSE50948_3 <- GSE50948$mRNA[GSE50948$genes %in% sub_gene,] ; rm(sub_gene)
GSE50948_4 <- GSE50948$mRNA[GSE50948$genes %in% bc_gene_list,] ; rm(dat); dim(GSE50948_3); dim(GSE50948_4)

# SL partner genes and ROC-AUC
pairs <- intersect(unique(candidates_sl$GENE_B), rownames(GSE50948_3))[1:nn]; print(pairs)
SL_AUC2(data1 = GSE50948_3, data2 = GSE50948_4, drugs = "TRASTUZUMAB", drug_response = GSE50948$outcome, 
         pair = pairs)

# SDL partner genes and ROC-AUC
pairs <- intersect(unique(candidates_sdl$GENE_B), rownames(GSE50948_3))[1:nn]; print(pairs)
SDL_AUC2(data1 = GSE50948_3, data2 = GSE50948_4, drugs = "TRASTUZUMAB", drug_response = GSE50948$outcome, 
         pair = pairs)

rm(GSE50948, GSE50948_3, GSE50948_4, pairs)

