# Odds ratio (Table1, Figure 2)
score_GSE50948 <- readRDS("./score_GSE50948.rds")
score_GSE37946 <- readRDS("./score_GSE37946.rds")
score_GSE42822 <- readRDS("./score_GSE42822.rds")
