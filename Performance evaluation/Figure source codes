# Assign colors to each type of drug.
colors <- c("TRASTUZUMAB (GSE50948)" = "blue", "TRASTUZUMAB (GSE37946)" = "blue4", 
            "TRASTUZUMAB (GSE42822)" = "cornflowerblue", "TRASTUZUMAB (TransNEO)" = "cadetblue",
            "VELIPARIB (GSE194040)" = "red", "VELIPARIB (GSE164458)"  ="darkred" ,
            "OLAPARIB (GSE173839)" = "orange", 
            "DURVALUMAB (GSE173839)" = "darkorchid4",
            "PEMBROLIZUMAB (GSE194040)" = "darksalmon")

data <- c("TRASTUZUMAB (GSE50948)", "TRASTUZUMAB (GSE37946)", 
          "TRASTUZUMAB (GSE42822)" , "TRASTUZUMAB (TransNEO)",
          "VELIPARIB (GSE194040)", "VELIPARIB (GSE164458)" ,
          "OLAPARIB (GSE173839)" , "DURVALUMAB (GSE173839)" ,"PEMBROLIZUMAB (GSE194040)")

# threshold = 0.51
odd2 <- c("2.318", "2.263" ,"11.25*", "1.895" ,"3.117*", "1.803*", "3.542*", "3.273*", "7.057*")
odd3 <- c("no","no","sig","no","sig","sig","sig","sig","sig")

odds <- mutate_all(ODDS[,2:5], function(x) as.numeric(as.character(x)))

DATA <- data.frame(data, odds, odd2, odd3)
DATA$data <- factor(DATA$data, levels = DATA$data)

ggplot(DATA, aes(x = data, y = odds, fill = data)) + geom_bar(stat="identity") + 
  theme(panel.border = element_rect(color = "black", fill = NA),  # Add border with color black
        panel.grid.major = element_blank(),  # Add major grid lines
        panel.grid.minor = element_blank(),  # Remove minor grid lines
        panel.background = element_blank(),
        strip.text = element_text(face="bold", size=9)) + xlab("Dataset") + ylab("Odds ratio") +
  scale_x_discrete(guide = guide_axis(n.dodge = 2)) + 
  scale_fill_manual("Dataset", values = colors) +
  geom_text(aes(label = odd2, y = odds), position = position_dodge(width = 1),
            vjust = -0.5, size = 5) # + geom_errorbar(aes(ymin = lower, ymax = upper), position = position_dodge(0.9), width = 0.2)

# P-values from Fisher's exact test are converted to their multiplicity-corrected form.
p_values <- DATA$p_val; print(p_values)
p_values_adj <- p.adjust(p_values[1:7], method = "BH"); round(p_values_adj,2); 
p_values_adj <- p.adjust(p_values[8:9], method = "BH"); round(p_values_adj,2); 


