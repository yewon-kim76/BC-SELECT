sco_durv <- readRDS("./score_durv.rds")

thres = 0.51 # The threshold for the odds ratio calculation is determined during the hyperparameter tuning step.

# Save all information across all datasets.
ODDS <- data.frame(
  data = c("GSE50948","GSE37946","GSE42822","transneo",
           "GSE194040","GSE164458","GSE173839",
           "Durv","Pemb"),
  odds = rep("",9),
  lower = rep("",9),
  upper = rep("",9),
  p_val = rep("",9))

ODDS[1,2:5] <- getOR2(score = score_GSE50948$new_sdl_score_target, idx.R = which(score_GSE50948$response == "1"),
                      idx.NR = which(score_GSE50948$response == "0"), thr = thres)

ODDS[2,2:5] <- getOR2(score = score_GSE37946$new_sdl_score_target, idx.R = which(score_GSE37946$response == "1"),
                      idx.NR = which(score_GSE37946$response == "0",), thr = thres)

ODDS[3,2:5] <- getOR2(score = score_GSE42822$new_sdl_score_target, idx.R = which(score_GSE42822$response == "1"),
