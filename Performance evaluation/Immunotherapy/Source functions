# For survival analysis, the minimum p-value is used among the p-values generated from different breast cancer datasets.
sr.find.dd.min <- function(sr.final1){
  sl.res=NA; FDR=0.2  # Step I: hypergeometric filter
  hyper <- apply(sr.final1[,c(3,4,5)], 2, function(x) p.adjust (x, method = "BH")) # Multiple testing correction
  colnames(hyper) <- c("BH_pval.mRNA1_2" ,  "BH_pval.mRNA1_3" , "BH_pval.mRAN.up_1")
  sr.final1 <- cbind(sr.final1, hyper)
  iy = which(apply(hyper, 1, min)< FDR) # Adjusted p-value with BH method length(iy) = 925
  
  if (length(iy)>1) {
  sr.final1 = sr.final1[iy,] # Step II: cox regression filter
  clinical.fdr2 = apply(sr.final1[,c(7,9,11)], 2, function(x) p.adjust (x, method = "BH")) # P-value for three datasets
  colnames(clinical.fdr2) <- c("BH_bb_pvalue_tcga", "BH_bb_pvalue_meta","BH_bb_pvalue_scanb")
  sr.final1 <- cbind(sr.final1, clinical.fdr2) # Save survival analysis results 
  iz = which(rowSums(clinical.fdr2 < FDR ) >= 1) # Adjusted p-value with BH method length(iz) = 10
    
  if (length(iz)>1) {
  sr.final1=sr.final1[iz,] # Step III: phylogenetic filter
  ix=which(sr.final1[,10] < 2.315712e+01 | sr.final1[,11] < 2.315712e+01 ) # PDCD1, CD274 similarity scores
  sr.final1=sr.final1[ix,]}}
  
  sl.res=sr.final1
  return(sl.res)}


# Function to convert p-value to Z-score
p_to_z <- function(p) { return(qnorm(1 - p))}




# Stouffer's method for weighting p-values can be applied in survival analysis to combine p-values derived from multiple breast cancer datasets.
sr.find.dd.stouffer <- function(sr.final1){
  sl.res=NA; FDR=0.2 # Step I: hypergeometric filter
  hyper <- apply(sr.final1[,c(3,4,5)], 2, function(x) p.adjust (x, method = "BH")) # Multiple testing correction
  colnames(hyper) <- c("BH_pval.mRNA1_2" ,  "BH_pval.mRNA1_3" , "BH_pval.mRAN.up_1")
  sr.final1 <- cbind(sr.final1, hyper)
  iy = which(apply(hyper, 1, min)< FDR) 

  # For two-tailed tests of 'cov' (the effect of genetic interactions), the p-values should be converted to one-tailed p-values.
  if (length(iy)>1) {
  sr.final1 = sr.final1[iy,] # Step II: cox regression filter 
  sr.final1[,7] = ifelse(sr.final1[,6] > 0 , (sr.final1[,7])/2, 1 - ((sr.final1[,7])/2) ) 
  sr.final1[,9] = ifelse(sr.final1[,8] > 0 , (sr.final1[,9])/2, 1 - ((sr.final1[,9])/2) )  
  sr.final1[,11] = ifelse(sr.final1[,10] > 0 , (sr.final1[,11])/2, 1 - ((sr.final1[,11])/2) )  
    
  combine_pvalues_stouffer <- function(pvals) {
   Z_scores <- apply(pvals, 2, p_to_z) # Convert p-values to Z-scores
   weights <- sqrt(c(1075, 1989, 2969)) # The weight is the function of the square root of the sample sizes.
   combined_Z <- rowSums(t(t(Z_scores) * weights), na.rm = TRUE) / sqrt(sum(weights^2)) # Combine Z-scores using weighted sum
   combined_pvals <- 1 - pnorm(combined_Z) # Convert combined Z-scores back to p-values
   return(combined_pvals) }
    
  # Apply the function to combine p-values across all datasets
  combined_pvals <- combine_pvalues_stouffer(sr.final1[,c(7,9,11)])
  adjusted_pvals <- p.adjust(combined_pvals, method = "BH") # Perform FDR correction
    
  sr.final1 <- cbind(sr.final1, combined_pvals, adjusted_pvals ) # Save survival analysis results 
  iz = which(adjusted_pvals < FDR ) # Adjusted p-value with BH method length(iz) = 11
    
  if (length(iz)>1) {
  flag=3
  sr.final1=sr.final1[iz,] # Step III: phylogenetic filter
  ix=which(sr.final1[,12] < 2.315712e+01 | sr.final1[,13] < 2.315712e+01 ) # PDCD1, CD274 scores
  sr.final1=sr.final1[ix,]} }  
  
  if (flag==3) sl.res=sr.final1
  return(sl.res)}




# A possible candidate of SR partner genes can be prioritized based on phylogenetic scores, 
# where the minimum scores between PDCD1 and CD274 are utilized.
sr.ranking.dd <-function(sr.final1){
  ps1 = sr.final1[,12] ; ps2 = sr.final1[,13] ## updated 								
  ps = ifelse(ps1 >= ps2, ps2, ps1)	
  ii = order(ps, decreasing = FALSE) # sort phylogenetic distance
  return(ii)}


# Patient scoring metric used in SELECT
sr.score.dd <- function(dat, sr.final1){ # SELECT-score method
  score1 = rep(0,ncol(dat$mRNA))	
  partners1 = match(sr.final1[,2], dat$genes)
  partners1 = partners1[!is.na(partners1)]
  if (length(partners1)==1) 
    score1=1*(dat$mRNA.rank2[partners1,] < 0.33) 
  if (length(partners1) >1) 
    score1=colSums(dat$mRNA.rank2[partners1,] < 0.33, na.rm=T)/length(partners1) # f -> probability of cancer cell survival
  score1=1-score1		# 1-f -> probability of cancer cell death, increase the chances of drug efficacy
  return(score1)}


# The patient scoring metric used in BC-SELECT requires SR partner genes selected through the gene pair identification step, 
# genes from the Nanostring list, and target gene expression (PDCD1/CD274).
new.sr.score.dd <- function(dat, sr.final1){ 
  score1 = rep(0,ncol(dat$mRNA))	
  partners1 = match(sr.final1[,2], dat$genes)
  partners1 = partners1[!is.na(partners1)]
  if (length(partners1)==1)
    score1=1*(dat$mRNA.rank2[partners1,] < 0.33)  
  if (length(partners1) >1)
    score1=colSums(dat$mRNA.rank2[partners1,] < 0.33, na.rm=T)/length(partners1) # f -> probability of cancer cell survival
  
  sub_gene <- intersect(nanostring, rownames(dat$mRNA)) # NanoString list 
  new_data <- dat$mRNA[rownames(dat$mRNA) %in% sub_gene,]
  new_data2 <- bin_matrix(new_data, direction = "row", bin = FALSE)
  new_data2 <- na.omit(new_data2)  # Remove NA
  whole_down <- apply(new_data2, 2 , down_counts)
  whole_down_patient <- as.numeric(colSums(whole_down))  # Count the down-regulated gene for each patient
  whole_score <- whole_down_patient / dim(new_data2)[1]
 
  new_score = (1- score1)/ (1-whole_score) # Expanded gene expression ratio 
  
  return(new_score)}


# Using the expanded gene expression ratio, we calculate patient response scores based on target gene expression for BC-SELECT. 
# Additionally, the two score components of BC-SELECT are also calculated.
eval.auc.dd = function(sr.final, dat, ires1, iirs1){
  res = NULL
  sr.x = cbind(genes[sr.final[,1]],genes[sr.final[,2]]) 
  #score1 = sr.score.dd(dat, sr.x) # For SELECT comparison 
  score1 = new.sr.score.dd(dat, sr.x) # Bring Expaned gene expression ratio
  a <- which(rownames(dat$mRNA) == "PDCD1"); b <- which(rownames(dat$mRNA) == "CD274") # Target genes expression
  target <- as.numeric(dat$mRNA[a,])*as.numeric(dat$mRNA[b,]) # Simple product
  pval = score1[c(ires1,iirs1)] # Reorder Expaned gene expression ratio
  target = target[c(ires1,iirs1)] # Reorder target gene expression
  flag = c(rep(1,length(ires1)),rep(0,length(iirs1))) # Reorder drug response
  res$score = pval; res$flag=flag # Expaned gene expression ratio
  res$score2 = pval*rank.norm(target) # BC-SELECT 
  res$score3 = rank.norm(target) # Target genes expression
  res$sr.x=sr.x
  return(res)}




