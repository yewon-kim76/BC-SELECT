## Evolutionary analysis of preserved gene expression relationships using the Euclidean distance of phylogenetic similarity scores 
## and feature weight.
## This is done by comparing the phylogenetic profile of the two genes A and B across 86 species.

# Function------------------------------------------------------------------------------------------------
phylogenetic_profiles <- function(phylo_profiles = phylo_profiles, # Dataframe of phylogenetic profiles of 19017 human genes across 86 eukaryotic genomes.
                                  feature_weight = feature_weight, # Data for feature weight which are determined basd on the phylogenetic tree
                                  sl_pairs) # For gene pair  A and B.
{
 sl_phylo <- cbind(  # Get ids
    match(sl_pairs[1], phylo_profiles$genes),
    match(sl_pairs[2], phylo_profiles$genes))
  
  # Get phylo profile for gene A (drug target) and gene B (partner gene)
  phylo_geneA <- phylo_profiles[sl_phylo[, 1], -(1:3)]
  phylo_geneB <- phylo_profiles[sl_phylo[, 2], -(1:3)]
  
  # Get the phylogenetic distance (Euclidean distance) between gene A (drug target) and gene B (partner gene) 
  featureMat <- (phylo_geneA - phylo_geneB)^2
  featureMat <- data.matrix(featureMat)
  nmf_res <- featureMat %*% t(feature_weight)
  nmf_res <- data.frame( t(sl_pairs), nmf_res[1], stringsAsFactors=FALSE)
  colnames(nmf_res) <- c("GENE_A", "GENE_B", "phylogenetic_similarity")
  nmf_res$rank_norm <- rank(
    nmf_res$phylogenetic_similarity,
    na.last = "keep" ) / length(nmf_res$phylogenetic_similarity)
  
  return(nmf_res) }

# Fit------------------------------------------------------------------------------------------------
phylo_profiles <- readRDS("/data/kimy35/SELECT/select_targeted/data/phylo.rds") # Load data
feature_weight <- readRDS("/data/kimy35/SELECT/select_targeted/data/feature_weight.rds") # Load data

drug_target = "CDK6"; phylo_result <- NULL 

for(i in 1:length(phylo_profiles$genes)){
  gene = as.character(phylo_profiles$genes)[i]  # All possible candidates partner genes (Bs)
  sl_pairs = c(drug_target, gene)  
  
  phylogenetic_similarity <- phylogenetic_profiles(phylo = phylo_profiles,
                                                   feature_weight = feature_weight,
                                                   sl_pairs = sl_pairs)
  phylo_result <-rbind(phylo_result, phylogenetic_similarity )
  print(i)}

setwd("/data/kimy35/BC-SELECT1.5/Training_dataset"))
saveRDS(phylo_result, file = "CDK6_phylo.rds") # Save data


